{{- $index := slice -}}
{{- $pages := where .Site.RegularPages "Draft" false -}}
{{- range where $pages "Params.unlisted" "ne" true -}}
  {{- $index = $index | append (dict
    "title" .Title
    "url" .RelPermalink
    "content" (.Plain | htmlUnescape)
    "tags" .Params.tags
  ) -}}
{{- end -}}
{{- $index | jsonify -}}
